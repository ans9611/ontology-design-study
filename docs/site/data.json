 "rq3": {
  "run_date": "2026-09-20",
  "scales": [
   1000,
   3000,
   10000
  ],
  "schemas": [
   "flat",
   "mid",
   "normalized"
  ],
  "queries": [
   {
    "id": "Q01",
    "question": "Given a person, list their friends' names and cities",
    "kind": "2-hop lookup"
   },
   {
    "id": "Q02",
    "question": "Given a person, list friends of friends who live in the same country",
    "kind": "3-hop with filter"
   },
   {
    "id": "Q03",
    "question": "Given a person, the 10 most recent posts by their friends",
    "kind": "neighborhood + sort"
   },
   {
    "id": "Q04",
    "question": "Given a person and a date range, the tags most used in their friends' posts",
    "kind": "aggregation over neighborhood"
   },
   {
    "id": "Q05",
    "question": "Given a person, the forums their friends joined after a date, ranked by number of posts from those friends",
    "kind": "join-heavy"
   },
   {
    "id": "Q06",
    "question": "Given a person and a tag, other tags that co-occur on posts by friends-of-friends",
    "kind": "4-hop co-occurrence"
   },
   {
    "id": "Q07",
    "question": "Given a person, who liked their posts recently and whether they are a friend",
    "kind": "reverse edge + membership test"
   },
   {
    "id": "Q08",
    "question": "Given a person, the latest comments replying to their posts",
    "kind": "reverse 2-hop"
   },
   {
    "id": "Q09",
    "question": "Given a person, recent messages by friends-of-friends before a date",
    "kind": "3-hop with filter"
   },
   {
    "id": "Q10",
    "question": "Given a person, friends with a birthday in a month, scored by common interests",
    "kind": "scoring over neighborhood"
   },
   {
    "id": "Q11",
    "question": "Given a person and a country, friends who work at companies in that country",
    "kind": "3-hop across entity types"
   },
   {
    "id": "Q12",
    "question": "Given a person and a tag class, friends who commented on posts about that class",
    "kind": "hierarchy traversal + 3-hop"
   },
   {
    "id": "Q13",
    "question": "Shortest path length between two persons",
    "kind": "variable-length path"
   },
   {
    "id": "Q14",
    "question": "Weighted shortest paths between two persons where weight depends on reply counts",
    "kind": "variable-length with computed weights"
   },
   {
    "id": "Q15",
    "question": "For a given post, its full comment thread",
    "kind": "recursive descent"
   },
   {
    "id": "Q16",
    "question": "For a given forum, members grouped by country with post counts",
    "kind": "group-by over 2 hops"
   },
   {
    "id": "Q17",
    "question": "For a given organisation, the tag distribution of posts by its employees",
    "kind": "3-hop aggregation"
   },
   {
    "id": "Q18",
    "question": "For a given tag, the number of posts per month over the last year",
    "kind": "time-bucketed count"
   },
   {
    "id": "Q19",
    "question": "For a given place, the people located there and their employers",
    "kind": "2-hop across types"
   },
   {
    "id": "Q20",
    "question": "For a given person, the ego network to depth 2 with PPR scores (uses `PPRMatrix`)",
    "kind": "centrality over neighborhood"
   }
  ],
