{
 "rq1": {
  "columns": [
   "structural (depth, breadth, richness)",
   "instance completeness / correctness",
   "formal soundness (taxonomy)",
   "usability / fitness for task",
   "operational cost (hops, latency, memory)",
   "adoption / maintenance"
  ],
  "rows": [
   {
    "framework": "OntoQA [5]",
    "cells": [
     "schema metrics: relationship richness, attribute richness, inheritance richness; knowledge-base metrics: class richness, cohesion",
     "instance distribution across classes (\"class connectivity\", \"class importance\")",
     "",
     "",
     "",
     ""
    ]
   },
   {
    "framework": "OQuaRE [6]",
    "cells": [
     "structural sub-characteristics mapped onto ISO/IEC 25000 (SQuaRE)",
     "",
     "",
     "functional adequacy, reliability, operability, maintainability, compatibility, transferability, all as SQuaRE characteristics",
     "\"performance efficiency\" appears as a SQuaRE characteristic but is scored from structural proxies, not measured",
     "maintainability sub-characteristics (modularity, reusability, analysability, changeability)"
    ]
   },
   {
    "framework": "Vrandečić [7]",
    "cells": [
     "covers structure as one of several aspects (vocabulary, syntax, structure, semantics, representation, context)",
     "gold-standard and data-driven evaluation",
     "",
     "application-based evaluation: does the ontology work in the application it was built for",
     "",
     ""
    ]
   },
   {
    "framework": "OntoClean [13]",
    "cells": [
     "",
     "",
     "rigidity, identity, unity, dependence constraints on the subsumption hierarchy",
     "",
     "",
     ""
    ]
   },
   {
    "framework": "Paulheim [14]",
    "cells": [
     "",
     "completeness and correctness of KG instances; refinement methods evaluated by precision/recall",
     "",
     "",
     "",
     ""
    ]
   },
   {
    "framework": "Noy et al. [15]",
    "cells": [
     "",
     "entity resolution and provenance as recurring challenges",
     "",
     "schema must be populated to be useful; \"the schema is what people will actually fill in\"",
     "",
     "schema evolution, governance, tooling named as open challenges"
    ]
   },
   {
    "framework": "Wikidata [16]",
    "cells": [
     "",
     "property constraints checked continuously",
     "",
     "",
     "",
     "community process as quality control"
    ]
   }
  ]
 },
